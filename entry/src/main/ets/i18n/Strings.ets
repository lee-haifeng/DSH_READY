/** Translate a key for a language, falling back to the key itself. */
export function translate(lang: string, key: string): string {
  const table: Record<string, string> = lang === LANG_EN ? EN : ZH;
  const value: string | undefined = table[key];
  return value === undefined ? key : value;
}

/** Full table for a language, used by the settings screen preview. */
export function tableFor(lang: string): Record<string, string> {
  return lang === LANG_EN ? EN : ZH;
}
